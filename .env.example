# Local development works without these values; production writes are disabled without them.
EVENTHEME_DATA_MODE=local
# Set EVENTHEME_DATA_MODE=supabase only after applying the migration and importing content.
# /admin always requires a Supabase Auth account with app_metadata.role = "admin",
# even with local data: set the URL and publishable key to sign in at all.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never use NEXT_PUBLIC_ for this value.
SUPABASE_SECRET_KEY=
APP_URL=http://localhost:3000
